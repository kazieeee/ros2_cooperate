#include <memory>
#include <queue>
#include <vector>
#include <mutex>
#include "rclcpp/rclcpp.hpp"
#include "std_msgs/msg/int32.hpp"

using std::placeholders::_1;

// 函数模板：算绝对差值
template <typename T>
T absoluteDifference(T a, T b) {
    return (a > b) ? (a - b) : (b - a);
}

class MySubscriber : public rclcpp::Node {
public:
    MySubscriber() : Node("subscriber"), prev_speed_(0) {
        // 创建订阅者，监听 "chatter"
        sub_ = this->create_subscription<std_msgs::msg::Int32>(
            "chatter", 10, std::bind(&MySubscriber::topic_cb, this, _1));
    }

private:
    void topic_cb(const std_msgs::msg::Int32::SharedPtr msg) {
        // 加锁保护队列和数组
        std::lock_guard<std::mutex> lock(mtx_);
        
        // 任务二：入队
        speed_queue_.push(msg->data);
        
        // 队列里至少有2个数据才处理
        if (speed_queue_.size() >= 2) {
            // 取出最早的队头
            int current = speed_queue_.front();
            // 踢出队头
            speed_queue_.pop();
            
            // 任务三：算差值（无多线程，直接调用）
            int diff = absoluteDifference(current, prev_speed_);
            
            // 存入历史差值数组
            diff_his_.push_back(diff);
            // 超过3个就删最早的
            if (diff_his_.size() > 3) {
                diff_his_.erase(diff_his_.begin());
            }
            
            // 统计 WARNING 次数
            int warn_count = 0;
            for (int d : diff_his_) {
                if (d >= 15) warn_count++;
            }
            
            // 判断输出
            if (warn_count >= 2) {
                RCLCPP_WARN(this->get_logger(), "System State: UNSTABLE");
            } else {
                RCLCPP_INFO(this->get_logger(), "System State: STABLE");
            }
            
            // 更新上一次速度
            prev_speed_ = current;
        }
    }

    rclcpp::Subscription<std_msgs::msg::Int32>::SharedPtr sub_;
    std::queue<int> speed_queue_;
    std::vector<int> diff_his_;
    std::mutex mtx_;
    int prev_speed_;
};

int main(int argc, char * argv[]) {
    rclcpp::init(argc, argv);
    rclcpp::spin(std::make_shared<MySubscriber>());
    rclcpp::shutdown();
    return 0;
}
